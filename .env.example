# ============================================================================
# n8n Full-Feature Setup Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment.
#
# TIP: After first launch, go to Settings > Usage and plan > Unlock
# and register with your email (free) to get additional features:
#   - Folders, Debug in editor, Custom execution data

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-this-password
DB_POSTGRESDB_POOL_SIZE=50

# ============================================================================
# REDIS CONFIGURATION (Cache & Queue)
# ============================================================================
REDIS_PASSWORD=change-this-redis-password

# ============================================================================
# n8n CORE CONFIGURATION
# ============================================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678

TIMEZONE=Asia/Kolkata
GENERIC_TIMEZONE=Asia/Kolkata

# ============================================================================
# n8n AUTHENTICATION & SECURITY
# ============================================================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password

# CRITICAL: Generate a unique encryption key
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=REPLACE-WITH-32-CHAR-ENCRYPTION-KEY

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_SECURE_COOKIE=false

# ============================================================================
# WORKER & QUEUE CONFIGURATION
# ============================================================================
EXECUTIONS_MODE=queue
N8N_WORKERS_ENABLED=true
N8N_WORKER_CONCURRENCY=20
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
QUEUE_BULL_REDIS_DB=0
QUEUE_HEALTH_CHECK_ACTIVE=true

# ============================================================================
# FEATURE TOGGLES - Enable All Available Features
# ============================================================================

# --- Templates & Community ---
N8N_TEMPLATES_ENABLED=true
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_VERIFIED_PACKAGES_ENABLED=true
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_REINSTALL_MISSING_PACKAGES=true

# --- Python Support in Code Node ---
N8N_PYTHON_ENABLED=true

# --- Code Node: Allow all built-in and external modules ---
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*

# --- Include all nodes (remove default exclusions) ---
# By default n8n 2.x excludes executeCommand and localFileTrigger.
# Uncomment below to re-enable them (useful for learning/experimentation):
# NODES_EXCLUDE=[]

# --- Public REST API ---
N8N_PUBLIC_API_DISABLED=false
N8N_PUBLIC_API_SWAGGERUI_DISABLED=false

# --- Task Runners (Code Node Isolation - n8n 2.x) ---
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=internal
N8N_RUNNERS_MAX_CONCURRENCY=10
N8N_RUNNERS_TASK_TIMEOUT=600

# --- Python Runner: Allow all modules ---
N8N_RUNNERS_STDLIB_ALLOW=*
N8N_RUNNERS_EXTERNAL_ALLOW=*

# --- Workflow & Editor Features ---
N8N_WORKFLOW_TAGS_DISABLED=false
N8N_ONBOARDING_FLOW_DISABLED=false
N8N_PERSONALIZATION_ENABLED=true
N8N_VERSION_NOTIFICATIONS_ENABLED=true

# --- Execution Settings ---
EXECUTIONS_TIMEOUT=-1
EXECUTIONS_TIMEOUT_MAX=3600
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=true
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
N8N_CONCURRENCY_PRODUCTION_LIMIT=-1

# --- Larger Payloads (for file/data-heavy workflows) ---
N8N_PAYLOAD_SIZE_MAX=64
N8N_FORMDATA_FILE_SIZE_MAX=500

# --- Metrics (Prometheus) ---
N8N_METRICS=true
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
N8N_METRICS_INCLUDE_CACHE_METRICS=true
N8N_METRICS_INCLUDE_MESSAGE_EVENT_BUS_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_NODE_TYPE_LABEL=true
N8N_METRICS_INCLUDE_CREDENTIAL_TYPE_LABEL=true
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
N8N_METRICS_INCLUDE_API_PATH_LABEL=true
N8N_METRICS_INCLUDE_API_METHOD_LABEL=true
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true

# --- Diagnostics (disable telemetry for privacy) ---
N8N_DIAGNOSTICS_ENABLED=false

# --- Disable hiring banner ---
N8N_HIRING_BANNER_ENABLED=false

# --- Hide usage page (optional - set to true to remove upgrade prompts) ---
N8N_HIDE_USAGE_PAGE=false

# --- AI / GenAI Features ---
# Note: AI assistant requires n8n Cloud or valid license for full functionality.
# These enable what is available in the community edition.
N8N_AI_TIMEOUT_MAX=3600000

# --- Security: Relaxed for learning environment ---
# WARNING: These are permissive settings for a local learning environment.
# Do NOT use these in production!
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=false

# ============================================================================
# LOGGING & PRUNING
# ============================================================================
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# --- Event Bus (Log Streaming) ---
N8N_EVENTBUS_CHECKUNSENTINTERVAL=0
N8N_EVENTBUS_LOGWRITER_KEEPLOGCOUNT=10
N8N_EVENTBUS_LOGWRITER_MAXFILESIZEINKB=10240

# ============================================================================
# EXTERNAL INTEGRATIONS (SMTP, etc.) - Optional
# ============================================================================
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=user@gmail.com
# N8N_SMTP_PASS=app-password
# N8N_SMTP_SENDER=user@gmail.com
# N8N_SMTP_SSL=false
# N8N_SMTP_STARTTLS=true
